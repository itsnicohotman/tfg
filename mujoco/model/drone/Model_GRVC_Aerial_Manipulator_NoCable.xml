<!-- MuJoCo Aerial Manipulator GRVC, Alejandro Suarez asuarezfm@us.es, Nicolás V. Hofmann Nieto nichofnie@alum.us.es -->

<mujoco model="GRVC_Aerial_Manipulator_1Cable">

  <!-- Specify angles in radians. Take inertia parameters from geometry, given body mass. -->
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  
  <!--Compiler options: integration method and time step -->
  <option integrator="implicit" timestep="0.001" density="1.204" viscosity="1.8e-5" gravity="0 0 -9.8" />
  <include file="../assets.xml"/>
  <extension>
    <plugin plugin="mujoco.elasticity.cable" />
  </extension>

  <visual>
    <map force="0.1" zfar="30"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global offwidth="2560" offheight="1440" elevation="-20" azimuth="120"/>
  </visual> 
  
  <worldbody>
    <light name="manipulator" mode="targetbodycom" target="LiCAS_A1" diffuse=".8 .8 .8" specular="0.3 0.3 0.3" pos="0 -6 4" cutoff="30"/>
    <light name="drone" mode="targetbodycom" target="drone" diffuse=".8 .8 .8" specular="0.3 0.3 0.3" pos="0 -6 4" cutoff="30"/>
    <light name="top" pos="0 0 2" mode="trackcom"/>

    <!-- Create the floor as a 20 by 20 m plane, 1 mm thickness -->
    <geom name="floor" size="10 10 .001" type="plane" material="grid" condim="3"/> 
    
    <!-- Create the robotic arm following a tree structure from the base link -->
    <body name="drone" pos="0 0 2">
      <!-- Create the geometry and set the physical properties of the manipulator base -->
      <geom name="Multirotor_X4_Base_geom" type="mesh" mesh="Multirotor_X4_Base_mesh" rgba="0.6 0.8 0.8 1"/>
<!--       <freejoint/>
 -->      <inertial pos="0 0 0" mass="4.65"/>

      <!-- Manipulator -->
      <body name="LiCAS_A1" pos="0 0 -0.125">
        <!-- Create the geometry and set the physical properties of the manipulator base -->
        <geom name="Shoulder_Pitch_Structure_geom" type="mesh" mesh="Shoulder_Pitch_Structure_mesh" rgba="0.6 0.8 0.8 1"/>
        <inertial pos="0 0 0" mass="0.639"/>
        <site name="LiCAS_base_center" pos="0 0 0.06" size="0.01" type="sphere" rgba="1 0 0 1" group="3" euler="0 1.57 0"/>
        
        <!-- Create the Left Arm Shoulder Roll Link -->
        <body name="Shoulder_Roll_Structure_Left" pos="0 0.2 0">
          <joint name="q11" type="hinge" axis="0 1 0" pos="0 0 0" range="-1.57 1.57" damping="0.1"/>
          <geom name="Shoulder_Roll_Structure_Left_geom" type="mesh" mesh="Shoulder_Roll_Structure_Left_mesh" rgba="0.5 0.75 0.75 1"/>
          <inertial pos="0 0 0" mass="0.233"/>
          
          <!-- Create the Left Arm Shoulder Yaw Link -->
          <body name="Shoulder_Yaw_Structure_Left" pos="0 0 0">
            <joint name="q12" type="hinge" axis="1 0 0" pos="0 0 0" range="-1.57 1.57" damping="0.1"/>
            <geom name="Shoulder_Yaw_Structure_Left_geom" type="mesh" mesh="Shoulder_Yaw_Structure_mesh" rgba="0.4 0.65 0.65 1"/>
            <inertial pos="0 0 0" mass="0.233"/>
          
            <!-- Create the Left Arm Elbow Pitch Link -->
            <body name="Elbow_Pitch_Structure_Left" pos="0 0 -0.25">
              <joint name="q13" type="hinge" axis="0 0 1" pos="0 0 0" range="-1.57 1.57" damping="0.1"/>
              <geom name="Elbow_Pitch_Structure_Left_geom" type="mesh" mesh="Elbow_Pitch_Structure_Left_mesh" rgba="0.4 0.65 0.65 1"/>
              <inertial pos="0 0 0" mass="0.246"/>
          
              <!-- Create the Left Arm Elbow Pitch Link -->
              <body name="Forearm_Link_with_Gripper_Servo_Left" pos="0 0 0">
                <joint name="q14" type="hinge" axis="0 1 0" pos="0 0 0" range="-2.618 2.618" damping="0.1"/>
                <geom name="Forearm_Link_with_Gripper_Servo_Left_geom" type="mesh" mesh="Forearm_Link_with_Gripper_Servo_mesh" rgba="0.4 0.65 0.65 1"/>
                <inertial pos="0 0 0" mass="0.106"/>
              </body>
            </body>    
          </body>
        </body>
      
      <!-- Create the Right Arm Shoulder Roll Link -->
        <body name="Shoulder_Roll_Structure_Right" pos="0 -0.2 0">
          <joint name="q21" type="hinge" axis="0 1 0" pos="0 0 0" range="-1.57 1.57" damping="0.1"/>
          <geom name="Shoulder_Roll_Structure_Right_geom" type="mesh" mesh="Shoulder_Roll_Structure_Right_mesh" rgba="0.5 0.75 0.75 1"/>
          <inertial pos="0 0 0" mass="0.233"/>
          
          <!-- Create the Left Arm Shoulder Yaw Link -->
          <body name="Shoulder_Yaw_Structure_Right" pos="0 0 0">
            <joint name="q22" type="hinge" axis="1 0 0" pos="0 0 0" range="-1.57 1.57" damping="0.1"/>
            <geom name="Shoulder_Yaw_Structure_Right_geom" type="mesh" mesh="Shoulder_Yaw_Structure_mesh" rgba="0.4 0.65 0.65 1"/>
            <inertial pos="0 0 0" mass="0.246"/>
          
            <!-- Create the Left Arm Elbow Pitch Link -->
            <body name="Elbow_Pitch_Structure_Right" pos="0 0 -0.25">
              <joint name="q23" type="hinge" axis="0 0 1" pos="0 0 0" range="-1.57 1.57" damping="0.1"/>
              <geom name="Elbow_Pitch_Structure_Right_geom" type="mesh" mesh="Elbow_Pitch_Structure_Right_mesh" rgba="0.4 0.65 0.65 1"/>
              <inertial pos="0 0 0" mass="0.214"/>
          
              <!-- Create the Right Arm Elbow Pitch Link -->
              <body name="Forearm_Link_with_Gripper_Servo_Right" pos="0 0 0">
                <joint name="q24" type="hinge" axis="0 1 0" pos="0 0 0" range="-2.618 2.618" damping="0.1"/>
                <geom name="Forearm_Link_with_Gripper_Servo_Right_geom" type="mesh" mesh="Forearm_Link_with_Gripper_Servo_mesh" rgba="0.4 0.65 0.65 1"/>
                <inertial pos="0 0 0" mass="0.106"/>
              </body>
            </body>
          </body>
        </body>
      </body>
      
      <!-- Create the Landing Gear Legs -->
      <body name="LandingGearLeg-1" pos="0.33835 -0.33835 -0.2">
        <geom name="Landing_Gear_Leg_geom-1" type="mesh" mesh="Landing_Gear_Leg_mesh" rgba="0.5 0.75 0.75 1"/>
        <inertial pos="0 0 0" mass="0.1"/>
      </body>
      <body name="LandingGearLeg-2" pos="0.33835 0.33835 -0.2">
        <geom name="Landing_Gear_Leg_geom-2" type="mesh" mesh="Landing_Gear_Leg_mesh" rgba="0.5 0.75 0.75 1"/>
        <inertial pos="0 0 0" mass="0.1"/>
      </body>
      <body name="LandingGearLeg-3" pos="-0.33835 0.33835 -0.2">
        <geom name="Landing_Gear_Leg_geom-3" type="mesh" mesh="Landing_Gear_Leg_mesh" rgba="0.5 0.75 0.75 1"/>
        <inertial pos="0 0 0" mass="0.1"/>
      </body>
      <body name="LandingGearLeg-4" pos="-0.33835 -0.33835 -0.2">
        <geom name="Landing_Gear_Leg_geom-4" type="mesh" mesh="Landing_Gear_Leg_mesh" rgba="0.5 0.75 0.75 1"/>
        <inertial pos="0 0 0" mass="0.1"/>
      </body>
      
      <!-- Create the propellers -->
      <body name="Propeller_Blade-1" pos="0.33835 -0.33835 0.065">
        <geom name="Propeller_Blade_geom-1" type="mesh" mesh="Propeller_Blade_mesh" rgba="0.5 0.75 0.75 1"/>
        <inertial pos="0 0 0" mass="0.01"/>
        <joint name="propeller-1" type="hinge" axis="0 0 1" pos="0 0 0" damping="0.0005"/>
      </body>
      <body name="Propeller_Blade-2" pos="0.33835 0.33835 0.065">
        <geom name="Propeller_Blade_geom-2" type="mesh" mesh="Propeller_Blade_mesh" rgba="0.5 0.75 0.75 1"/>
        <inertial pos="0 0 0" mass="0.01"/>
        <joint name="propeller-2" type="hinge" axis="0 0 1" pos="0 0 0" damping="0.0005"/>
      </body>
      <body name="Propeller_Blade-3" pos="-0.33835 0.33835 0.065">
        <geom name="Propeller_Blade_geom-3" type="mesh" mesh="Propeller_Blade_mesh" rgba="0.5 0.75 0.75 1"/>
        <inertial pos="0 0 0" mass="0.01"/>
        <joint name="propeller-3" type="hinge" axis="0 0 1" pos="0 0 0" damping="0.0005"/>
      </body>
      <body name="Propeller_Blade-4" pos="-0.33835 -0.33835 0.065">
        <geom name="Propeller_Blade_geom-4" type="mesh" mesh="Propeller_Blade_mesh" rgba="0.5 0.75 0.75 1"/>
        <inertial pos="0 0 0" mass="0.01"/>
        <joint name="propeller-4" type="hinge" axis="0 0 1" pos="0 0 0" damping="0.0005"/>
      </body>      
    </body>
  </worldbody>
 
  <actuator>
    <!-- Drone motors -->
    <motor name="propeller-1_motor" joint="propeller-1" gear="1" ctrlrange="-100 100" ctrllimited="true"/>
    <motor name="propeller-2_motor" joint="propeller-2" gear="1" ctrlrange="-100 100" ctrllimited="true"/>
    <motor name="propeller-3_motor" joint="propeller-3" gear="1" ctrlrange="-100 100" ctrllimited="true"/>
    <motor name="propeller-4_motor" joint="propeller-4" gear="1" ctrlrange="-100 100" ctrllimited="true"/>

    <!-- Manipulator motors -->
    <motor name="left_shoulder_roll" joint="q11" gear="10" ctrlrange="-2 2" ctrllimited="true"/>
    <motor name="left_shoulder_pitch" joint="q12" gear="10" ctrlrange="-1 1" ctrllimited="true"/>
    <motor name="left_elbow_roll" joint="q13" gear="10" ctrlrange="-1 1" ctrllimited="true"/>
    <motor name="left_elbow_pitch" joint="q14" gear="10" ctrlrange="-1 1" ctrllimited="true"/>
    <motor name="right_shoulder_roll" joint="q21" gear="10" ctrlrange="-2 2" ctrllimited="true"/>
    <motor name="right_shoulder_pitch" joint="q22" gear="10" ctrlrange="-1 1" ctrllimited="true"/>
    <motor name="right_elbow_roll" joint="q23" gear="10" ctrlrange="-1 1" ctrllimited="true"/>
    <motor name="right_elbow_pitch" joint="q24" gear="10" ctrlrange="-1 1" ctrllimited="true"/>
  </actuator>
</mujoco>

